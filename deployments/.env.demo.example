# =============================================================================
#  3REco - demo site environment (deployments/docker-compose.demo.yml)
#
#  Copy this file to .env.demo in the repo root and never commit it. Use new
#  secrets: do not reuse any value from the live .env. There is no email key and
#  no push key on purpose: the demo refuses to start with either.
# =============================================================================

# Public origin of the demo. Used for CORS, CSRF and WebSockets.
THREERECO_WEB_ORIGIN=https://demo.3reco.co.za

# Address of your reverse proxy (comma separated; empty trusts nobody).
THREERECO_TRUSTED_PROXIES=

# Demo database and file store passwords.  Make each with:  openssl rand -hex 24
DEMO_POSTGRES_PASSWORD=
DEMO_MINIO_ROOT_USER=threereco
DEMO_MINIO_ROOT_PASSWORD=

# 32 random bytes, base64:  openssl rand -base64 32
# The demo holds no real data, so this must NOT be the live key.
THREERECO_FIELD_KEY=
