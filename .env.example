# =============================================================================
#  3REco - production environment (docker-compose.yml, deploy.sh)
#
#  Copy this file to .env, fill in your values, and never commit .env.
#  deploy.sh writes this file for you and makes the secrets.
# =============================================================================

# Root domain. The proxy in front answers app.<DOMAIN> (the API and web app,
# 127.0.0.1:8180) and docs.<DOMAIN> (127.0.0.1:3001).
DOMAIN=yourdomain.com

# Public origin of the web app. Used for CORS, CSRF, WebSockets and email links.
THREERECO_WEB_ORIGIN=https://app.yourdomain.com

# Address of your reverse proxy, so the API believes X-Forwarded-For
# (comma separated; empty trusts nobody).
THREERECO_TRUSTED_PROXIES=

# Database and file store passwords.  Make each with:  openssl rand -hex 24
POSTGRES_PASSWORD=
MINIO_ROOT_USER=threereco
MINIO_ROOT_PASSWORD=

# Encrypts ID numbers, bank account numbers and e-wallet ids. 32 random bytes,
# base64.  Make one with:  openssl rand -base64 32
# Keep a copy somewhere safe, apart from the database backups. If it is lost,
# those fields cannot be read again.
THREERECO_FIELD_KEY=

# Email (Resend). AUTH_FROM_EMAIL must be a sender verified in Resend.
RESEND_API_KEY=
AUTH_FROM_EMAIL=noreply@yourdomain.com
